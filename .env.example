# Copy this file to .env before running the app.
# .env is git-ignored — .env.example is the committed template so anyone
# cloning this repo knows which variables can be set.

# Port the Express server listens on.
PORT=3000

# DB_PATH is intentionally NOT set here. Locally (npm start, no Docker) it
# defaults to ./tasks.db next to db.js. Inside Docker, compose.yaml sets it
# to /data/tasks.db to match the mounted volume — that's container-specific
# wiring, not a secret, so it lives in compose.yaml rather than here.